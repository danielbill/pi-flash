package pf:plugin;

interface types {
    variant paint { rect(rect), text(text) }
    record rect {
        x: f32, y: f32, w: f32, h: f32,
        corner: f32,
        r: f32, g: f32, b: f32, a: f32,
    }
    record text {
        x: f32, y: f32, size: f32,
        r: f32, g: f32, b: f32, a: f32,
        content: string,
    }
    enum phase { move, down, up }
    enum button { left, right }

    // 宿主→插件事件：契约里每种 `contributes.*` 回调都走这一条通道，
    // 以后加贡献项不用再改 WIT。
    //   kind = "panel-open"（tab/面板打开） | "menu"（文件树右键项） |
    //          "command"（组件菜单项）
    record plugin-event {
        kind: string,
        // contributes 里的 id（file_menu.id / panels.id）；panel-open 为空
        id: string,
        // 目标路径（file_menu/command 带；其余为空）
        path: string,
    }
}

interface host {
    measure-text: func(content: string, size: f32) -> f32;
    toast: func(msg: string);
    open-file: func(path: string);
    run-script: func(path: string);
    toggle-quick-pin: func(path: string);
    quick-pins: func() -> list<string>;

    // 02 §3 自管存储的 wasm 面：读写插件私有 data 目录下的单文件（key = 文件名，
    // 宿主拒绝分隔符/.. /隐藏文件）。missing → 空串，由插件兜底。
    storage-read: func(key: string) -> string;
    storage-write: func(key: string, data: string);

    // 090-5 L3：官方宿主证明。宿主只递数据不判定（nonceTag 现算，算法公开，
    // 插件 wasm 内用 pf-inner-verify 同算法复算比对）。
    record host-proof {
        kid: string,
        proof: string,
        nonce-tag: string,
    }
    get-host-proof: func(nonce: string) -> host-proof;
}

world plugin {
    use types.{paint, phase, button, plugin-event};

    import host;

    // 返回 Err = 插件自拒（如宿主证明验签失败）→ 宿主拒载并透传原因（失败不静默）。
    export init: func(plugin-name: string) -> result<_, string>;
    export on-event: func(ev: plugin-event);
    export on-resize: func(w: f32, h: f32);
    export on-mouse: func(phase: phase, button: button, x: f32, y: f32);
    export on-key: func(key: string);
    export wants-repaint: func() -> bool;
    export render: func() -> list<paint>;
}
