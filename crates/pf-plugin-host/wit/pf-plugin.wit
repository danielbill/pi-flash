// PF 插件契约（wasm 形态）——**与 JS 插件同一份契约**：插件返回组件树 JSON，
// 宿主解释器统一渲染（01 规范）。wasm 只是另一种载体，不另立渲染模型。
//
// 本副本 = 宿主**装载面下限**（8tb.2 起）：world 导出只含 v2 面（init /
// on-event / render）——契约 v3 钩子导出（fn-bar / render-popup /
// session-row）**不进 world**，由 PluginInstance 在实例化时探测（能力面，
// 缺 = 功能关，旧 wasm 包不受影响）；90-9 的 `unload` 同走能力面探测。
// host 接口的 import（如 open-popup）可以加——旧包不 import 它就不引用，
// 链接器多备无害。
package pf:plugin;

interface types {
    // 宿主→插件事件：契约里每种 `contributes.*` 回调都走这一条通道，
    // 以后加贡献项不用再改 WIT（JS 的 onMenu / onCommand / onPanelOpen /
    // onBroadcast 同源）。
    //   kind = "panel-open" | "menu" | "command" | "action" | "broadcast"
    //        | "svc-message"（v4 执行域推送：id = 插件 id，
    //          path = 负载 JSON，形如 {"payload":…,"meta":{"anchor":…,"key":…}}）
    //        | "page-active"（契约 v3，PF 钩子 page_actived：当前页会话变化，
    //          与 broadcast "session" 同拍。id 空串，path = env JSON
    //          {"session":{"key":…}}；旧 wasm 不认识即忽略，无害）
    //   id   = contributes 里的 id（file_menu.id / panels.id / 组件动作 id）；
    //          broadcast = 事件名（broadcast_events：inputpanel / claim）
    //   path = 目标路径（file_menu/command/action 带；broadcast = 负载 JSON 串；
    //          其余为空）
    record plugin-event {
        kind: string,
        id: string,
        path: string,
    }
}

interface host {
    measure-text: func(content: string, size: f32) -> f32;
    toast: func(msg: string);
    open-file: func(path: string);
    run-script: func(path: string);
    quick-pins: func() -> list<string>;
    // 与 JS 插件 ctx.fileIcon / ctx.isExecutive 同一能力面（派生值现算，不落盘）
    file-icon: func(path: string) -> string;
    is-executive: func(path: string) -> bool;

    // 02 §3 自管存储的 wasm 面：读写插件私有 data 目录下的单文件（key = 文件名，
    // 宿主拒绝分隔符/.. /隐藏文件）。missing → 空串，由插件兜底。
    storage-read: func(key: string) -> string;
    storage-write: func(key: string, data: string);

    // 090-5 L3：官方宿主证明。宿主只递数据不判定（nonceTag 现算，算法公开，
    // 插件 wasm 内用 pf-inner-verify 同算法复算比对）。
    record host-proof {
        kid: string,
        proof: string,
        nonce-tag: string,
    }
    get-host-proof: func(nonce: string) -> host-proof;

    // 意图调用：新建插件认领会话（契约 v2.4 ctx.newDraft 同一面）。同步无
    // 返回值（动作队列模型），宿主建线后经 on-event broadcast "claim" 回推
    // {key,name,cwd}（插件存指针）；失败经宿主状态栏提示透传。
    new-draft: func(prefix: string, cwd: string);

    // 契约 v4 执行域（90-6）：向该会话的执行面实例投递一条不透明消息。
    // 直接落盘（实例未运行时留存，启动即消费）；false = 无此锚点/写入失败。
    // JS 载体同面：ctx.service.post(anchor|key, msg)。
    svc-post: func(anchor-or-key: string, payload: string) -> bool;

    // 契约 v4 执行域：实例生命周期事实（running | stopped | absent）。
    svc-query: func(anchor-or-key: string) -> string;

    // 契约 v3 act.openPopup（8tb.2）：打开插件清单 contributes.popups 声明的
    // 条目。非模态——窗体/定位/尺寸档位全归宿主，插件只给内容树。意图调用
    // （动作队列，与 new-draft 同款）：同步无返回值；id 未声明 → 宿主忽略。
    // import 对旧包无害（不 import 即不引用）。
    open-popup: func(id: string);
}

world plugin {
    use types.{plugin-event};

    import host;

    // 返回 Err = 插件自拒（如宿主证明验签失败）→ 宿主拒载并透传原因（失败不静默）。
    export init: func(plugin-name: string) -> result<_, string>;
    // contributes.* 回调（文件树右键 / 组件动作 / 面板打开）
    export on-event: func(ev: plugin-event);
    // 01 规范组件树 JSON（与 JS `render(ctx)` 返回值逐字段一致；值内联、动作显式）
    export render: func() -> string;
}
