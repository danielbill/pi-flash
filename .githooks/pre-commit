#!/bin/bash
# 提交前钩子：① 自动格式化 ② 批量入库事故网（pi-flash engineering.md §格式化）
#
# 本仓自 2026-10-20 起是 rustfmt-clean 仓（基线提交见 .git-blame-ignore-revs），
# 所以格式化是**幂等**的：对已 clean 的文件再跑 rustfmt 只动你新写的那几行。
# 这就是「排版交给脚本、agent 不用记规则」的物理前提。
#
# ① 自动格式化：对本次**暂存的 `crates/**.rs`** 跑 rustfmt，改了就自动 git add
#    回暂存区（所以 commit 里看到的已是格式化后的版本）。
#    · `vendor/**` 永不格式化：那是 vendored 上游副本（workspace exclude），
#      格式化会把补丁面炸开。路径 spec 已限定 crates/。
#    · `crates/app/src/i18n.rs` 的 TABLE 由文件内 `#[rustfmt::skip]` 局部豁免，
#      不需要在这里特判（i18n_audit 按行解析表行，折行即 panic）。
#    · 有未暂存改动的文件跳过自动格式化（避免把未暂存内容一并 git add）；
#      它下次提交时自然会被格式化。
#
# ② 批量拦截：单次暂存 ≥ 30 文件即拦（防「整包格式化 / 大批无关改动被顺手
#    add」这类事故）。逃生：`git commit --no-verify` 或 `PI_FLASH_ALLOW_BULK=1`。
#
# 启用（克隆后执行一次）：
#   git config core.hooksPath .githooks
#   git config blame.ignoreRevsFile .git-blame-ignore-revs

set -uo pipefail

staged=$(git diff --cached --name-only)

# git add 带重试：多 agent 并行同仓时会短暂撞 index.lock。失败必须显式中止
# ——静默丢暂存 = 提交里混入未格式化版本 + 工作区遗留排版差异
#（itlq.12 / itlq.9 两次遗留的根因）。
stage_file() {
    local f=$1 try
    for try in 1 2 3; do
        if git add -- "$f" 2>/tmp/precommit-add.err; then
            return 0
        fi
        sleep 0.3
    done
    return 1
}

# ---------- ① 自动格式化 ----------
if command -v rustfmt >/dev/null 2>&1; then
    formatted=()
    skipped=0
    mapfile -t rs_files < <(git diff --cached --name-only --diff-filter=ACM -- 'crates/*.rs')
    for f in "${rs_files[@]}"; do
        if ! git diff --quiet -- "$f"; then
            # 工作区比暂存区多出的内容分两种：真 WIP（不接管，防 git add
            # 把未暂存内容卷进提交），或上一轮 hook 中止留下的**纯排版**
            # 差异（回暂存即收敛，不收敛就会把未格式化版带进历史——
            # 「下次提交自然会被格式化」的旧说法只对前者成立，是假话）。
            # 判据：暂存版经 rustfmt 后与工作区逐字节相等 = 差异只有排版。
            # 临时副本放 .git/ 里，rustfmt 才能沿目录找到仓根的 rustfmt.toml。
            if git show ":$f" > .git/precommit-drift.rs 2>/dev/null \
                && rustfmt --edition 2024 .git/precommit-drift.rs 2>/dev/null \
                && diff -q .git/precommit-drift.rs "$f" >/dev/null 2>&1; then
                if ! stage_file "$f"; then
                    echo "⛔ git add 失败（index.lock 持续被占）：$f"
                    sed -n '1,3p' /tmp/precommit-add.err
                    echo "   排版已写进工作区。重交前先 git add $f 再 git commit。"
                    exit 1
                fi
                formatted+=("$f")
            else
                skipped=$((skipped + 1))
            fi
            rm -f .git/precommit-drift.rs
            continue
        fi
        if ! rustfmt --edition 2024 "$f" 2>/tmp/precommit-fmt.err; then
            echo "⛔ rustfmt 失败（多半是语法错）：$f"
            sed -n '1,5p' /tmp/precommit-fmt.err
            exit 1
        fi
        if ! git diff --quiet -- "$f"; then
            if ! stage_file "$f"; then
                echo "⛔ git add 失败（index.lock 持续被占，多半有并行会话在提交）：$f"
                sed -n '1,3p' /tmp/precommit-add.err
                echo "   排版已写进工作区。重交前先 git add $f 再 git commit。"
                exit 1
            fi
            formatted+=("$f")
        fi
    done
    # 终检：本轮格式化过的文件必须已落暂存区（工作区 == 暂存区）。防上面
    # 任何一环静默失手——宁可拦下重交，不可把未格式化版本带进历史。
    for f in ${formatted[@]+"${formatted[@]}"}; do
        if ! git diff --quiet -- "$f"; then
            echo "⛔ 终检失败：$f 格式化后未落暂存区，提交中止"
            echo "   （排版已写进工作区：git add $f && git commit 重交即可）"
            exit 1
        fi
    done
    if [ "${#formatted[@]}" -gt 0 ]; then
        echo "[pre-commit] 自动格式化 ${#formatted[@]} 个文件并已重新暂存："
        printf '  %s\n' "${formatted[@]}"
    fi
    if [ "$skipped" -gt 0 ]; then
        echo "[pre-commit] 跳过 $skipped 个含未暂存 WIP 的文件（工作区差异不只是排版，不接管）"
    fi
else
    echo "[pre-commit] 警告：找不到 rustfmt，跳过自动格式化"
fi

# ---------- ② 批量入库事故网 ----------
count=$(printf '%s\n' "$staged" | grep -c .)

if [ "$count" -lt 30 ]; then
    exit 0
fi

if [ -n "${PI_FLASH_ALLOW_BULK:-}" ]; then
    echo "[pre-commit] PI_FLASH_ALLOW_BULK=1，放行 $count 文件大批量提交"
    exit 0
fi

echo ""
echo "⛔ 拦截：本次提交暂存了 $count 个文件（阈值 30）。"
echo ""
echo "   若这是整包 cargo fmt / rustfmt 的产物（洪泛）：本仓排版已由本钩子自动"
echo "   处理，不需要手工整包格式化，见 docs/agents/engineering.md。处理："
echo "     scripts/fmt-flood-clean.sh   # 一键封存到 stash"
echo ""
echo "   若这是真实的大规模提交（如刚做完全仓基线）："
echo "     PI_FLASH_ALLOW_BULK=1 git commit …   # 显式放行"
echo "     git commit --no-verify              # 连格式化一起跳过"
echo ""
exit 1
